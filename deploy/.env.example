# Biomni production environment
# Copy to /opt/biomni/.env on the VM (or another path and set ENV_FILE_PATH in compose)

# Session cookie secret (generate a long random string)
SESSION_SECRET=replace_with_random_string

# Azure Entra (App registration)
CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace_with_client_secret
TENANT_ID=00000000-0000-0000-0000-000000000000

# OpenAI/Azure OpenAI (optional, used by agent)
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_ENDPOINT=
OPENAI_API_TYPE=azure

# Biomni data paths inside the container
# Mount your data volume to /mnt/biomni_data in docker-compose
BIOMNI_BASE_PATH=/mnt/biomni_data
USER_DB_DIR=/mnt/biomni_data/user_dbs

# Optional: control S3 bootstrap downloads (useful for local/dev)
# Skip downloading data_lake/benchmark at startup (true/false)
BIOMNI_SKIP_DOWNLOADS=false
# Per-request timeout in seconds for S3 HTTP downloads (float, e.g., 30)
BIOMNI_DOWNLOAD_TIMEOUT=30
# Override S3 base URL if needed
BIOMNI_S3_BASE_URL=https://biomni-release.s3.amazonaws.com
