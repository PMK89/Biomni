# Biomni local development/test environment
# These are placeholders. For full login, set valid Microsoft Entra (Azure AD) values and local redirect URIs.
# Redirects for local root path:
#   http://localhost:8000/getAToken  (redirect)
#   http://localhost:8000/            (post-logout)
# Redirects for local subpath (if ROOT_PATH=/biomni):
#   http://localhost:8000/biomni/getAToken
#   http://localhost:8000/biomni/

SESSION_SECRET=local_dev_secret_change_me

CLIENT_ID=00000000-0000-0000-0000-000000000000
CLIENT_SECRET=replace_with_client_secret
TENANT_ID=00000000-0000-0000-0000-000000000000

# Optional OpenAI/Azure OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_ENDPOINT=
OPENAI_API_TYPE=azure

# Data paths
BIOMNI_BASE_PATH=/mnt/biomni_data
USER_DB_DIR=/mnt/biomni_data/user_dbs
